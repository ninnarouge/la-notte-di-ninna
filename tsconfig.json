{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "isolatedModules": true,
    "useDefineForClassFields": true
  },
  "include": [
    "src",
    "shared",
    "netlify",
    "vite.config.ts",
    "tests",
    "scripts/*.ts"
  ]
}